[postgres]
dbname = "neondb"
user = "your_database_user"
password = "replace_me"
host = "your_database_host"
port = 5432
sslmode = "require"
pool_size = 10

[admin]
# Tài khoản admin nay lưu trong database (bảng admin_users, tạo bởi migration 003).
# Mặc định: admin / 123456 -> đăng nhập rồi bấm "🔑 Đổi mật khẩu" để đổi.

[visitor]
reset_period = "day"   # "day" = tài khoản khách tạm reset mỗi ngày, "week" = reset mỗi thứ Hai
tie_metres = 5         # chênh lệch <= 5 m được xem là "cùng khoảng cách"

[app]
public_url = "https://hdvthaocamvien.streamlit.app/"   # địa chỉ in lên mã QR
